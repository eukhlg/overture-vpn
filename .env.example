L2TP_PASSWORD=change-this-password
L2TP_USERNAME=vpn
# For multiple users, replace the two variables above with:
# L2TP_USERS=alice=password-one,bob=password-two
L2TP_AUTH=mschapv2
# 0=off, 1=protocol/lifecycle diagnostics, 2=per-packet tracing
L2TP_DEBUG=0
L2TP_HOSTNAME=l2tp-go
L2TP_CLIENT_SUBNET=10.0.0.0/24
L2TP_SERVER_IP=1
L2TP_CLIENT_POOL_START=2
L2TP_CLIENT_POOL_SIZE=50
L2TP_DNS=1.1.1.1
L2TP_MTU=1400
L2TP_MAX_SESSIONS=50
L2TP_MAX_SESSIONS_PER_TUNNEL=1
L2TP_MAX_SESSIONS_PER_USER=1
# NAT is enabled and its interface is discovered automatically.
# L2TP_NAT_ENABLED=false
# L2TP_NAT_INTERFACE=eth0

# Experimental IKEv1 + ESP transport mode (raw ESP and NAT-T UDP/4500).
L2TP_IPSEC_ENABLED=false
L2TP_IPSEC_PSK=change-this-ipsec-key
L2TP_IPSEC_SERVER_ID=203.0.113.10
L2TP_IPSEC_FORCE_NATT=true
L2TP_IPSEC_IKE_LIFETIME=8h
L2TP_IPSEC_ESP_LIFETIME=1h
L2TP_IPSEC_DPD_INTERVAL=20s
L2TP_IPSEC_MAX_HALF_OPEN=128
L2TP_IPSEC_MAX_SA_PER_PEER=4
