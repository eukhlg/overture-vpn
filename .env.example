L2TP_PASSWORD=change-this-password
L2TP_USERNAME=vpn
# For multiple users, replace the two variables above with:
# L2TP_USERS=alice=password-one,bob=password-two
L2TP_AUTH=mschapv2
L2TP_DEBUG=false
L2TP_HOSTNAME=l2tp-go
L2TP_CLIENT_SUBNET=10.0.0.0/24
L2TP_SERVER_IP=1
L2TP_CLIENT_POOL_START=2
L2TP_CLIENT_POOL_SIZE=50
L2TP_DNS=1.1.1.1
L2TP_MTU=1400
L2TP_MAX_SESSIONS=50
L2TP_MAX_SESSIONS_PER_TUNNEL=1
L2TP_MAX_SESSIONS_PER_USER=1
# NAT is enabled and its interface is discovered automatically.
# L2TP_NAT_ENABLED=false
# L2TP_NAT_INTERFACE=eth0
