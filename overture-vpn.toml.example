[server]
listen = ":1701"
hostname = "l2tp-go"
# 0 disables diagnostics, 1 logs protocol and lifecycle events, and 2 also
# traces every ESP/L2TP/PPP/IP packet.
debug = 0

[authentication]
method = "mschapv2"

[[authentication.users]]
username = "vpn"
password = "replace-me"

# Add more [[authentication.users]] blocks for additional accounts.

[network]
subnet = "10.0.0.0/24"
server_address = "1"
client_pool_start = "2"
client_pool_size = 50
dns = "1.1.1.1"
mtu = 1400

[tun]
enabled = true
name = "l2tp0"

[nat]
enabled = true
# Leave empty to discover the interface from the default IPv4 route.
interface = ""

[ipsec]
# Bytes per NAT-T/raw ESP receive socket; 0 keeps the kernel default.
# L2TP_IPSEC_RECEIVE_BUFFER overrides this value. Linux reports 2x the request.
# Larger buffers reduce drops and can improve throughput, at the cost of more
# queueing delay under saturation (VPS 1 MiB: loaded p95 2.4 -> 13.6 ms).
receive_buffer = 0
# NAT-T receive and ESP sender batch size, 1..256; L2TP_IPSEC_UDP_BATCH.
udp_batch = 32
# Omit for an automatic count of clamp(GOMAXPROCS/3, 1, 4).
# Set explicitly to override; 0 or 1 uses the serial receive path.
# receive_workers = 2
# Experimental IKEv1 + raw ESP and NAT-T transport. Requires CAP_NET_RAW.
enabled = true
ike_listen = ":500"
natt_listen = ":4500"
esp_listen = "0.0.0.0"
pre_shared_key = "replace-me"
server_id = "203.0.113.10"
max_sas = 1024
force_natt = true
# Receive replay window, in packets: multiples of 64 from 64 through 1024.
# Optional environment override: L2TP_IPSEC_REPLAY_WINDOW_SIZE.
replay_window_size = 1024
ike_lifetime = "8h"
esp_lifetime = "1h"
dpd_interval = "20s"
max_half_open = 128
max_sa_per_peer = 4

[limits]
sessions = 50
sessions_per_tunnel = 1
sessions_per_user = 1
# Per-source-IP token bucket for new L2TP tunnel requests. Set the rate to 0
# to disable it. Retransmissions of an existing half-open request are exempt.
new_tunnels_per_second = 5
new_tunnel_burst = 10
