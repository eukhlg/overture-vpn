[server]
listen = ":1701"
hostname = "l2tp-go"
# 0 disables diagnostics, 1 logs protocol and lifecycle events, and 2 also
# traces every ESP/L2TP/PPP/IP packet.
debug = 0

[authentication]
method = "mschapv2"

[[authentication.users]]
username = "vpn"
password = "replace-me"

# Add more [[authentication.users]] blocks for additional accounts.

[network]
subnet = "10.0.0.0/24"
server_address = "1"
client_pool_start = "2"
client_pool_size = 50
dns = "1.1.1.1"
mtu = 1400

[tun]
backend = "system" # L2TP_TUN_BACKEND
offload = true # L2TP_TUN_OFFLOAD; Linux VNET_HDR, with runtime fallback
# Linux TUN transmit ring (txqueuelen); L2TP_TUN_TX_QUEUE_LENGTH, 0..65535.
# 0 = automatic: 32 with offload active, kernel setting otherwise. Shorter
# rings bound download queueing delay; offload makes each entry up to 64 KB.
tx_queue_length = 0
enabled = true
name = "l2tp0"

[nat]
enabled = true
# Leave empty to discover the interface from the default IPv4 route.
interface = ""

[l2tp]
# Plain UDP/1701 receive buffer in bytes; L2TP_RECEIVE_BUFFER. 0 keeps the
# kernel default. Larger buffers can add queueing delay under saturation.
receive_buffer = 1048576
# Receive/send batch size, 1..256; L2TP_UDP_BATCH.
udp_batch = 128
# Linux UDP send segmentation; L2TP_UDP_GSO. Unsupported sockets fall back.
udp_gso = true
# Sender goroutines on the plain socket, 0..16; L2TP_SEND_SHARDS. Each inner
# flow stays on one shard, in order. 0 = automatic clamp(GOMAXPROCS/3, 1, 4).
send_shards = 0

[ipsec]
# Bytes per NAT-T/raw ESP receive socket; 0 keeps the kernel default.
# L2TP_IPSEC_RECEIVE_BUFFER overrides this value. Linux reports 2x the request.
# Larger buffers reduce drops and can improve throughput, at the cost of more
# queueing delay under saturation. VPS, batch 128, upload over 256 KiB:
# 512 KiB +5% (1 stream) / +14% (4 streams), 1 MiB +7% / +17%; loaded upload
# ping p50 at 4 streams 2.3 / 3.9 / 6.8 ms. Use 0 for the lowest delay.
receive_buffer = 524288
# NAT-T receive batch size, 1..256; L2TP_IPSEC_UDP_BATCH.
# 128 gained 3.3% geometric-mean throughput in the VPS matrix, using more RX storage.
udp_batch = 128
# ESP sender batch size, 1..256; L2TP_IPSEC_UDP_SEND_BATCH.
udp_send_batch = 128
# Linux UDP send segmentation; L2TP_IPSEC_UDP_GSO.
udp_gso = true
# Omit for an automatic count of clamp(GOMAXPROCS/3, 1, 4).
# Set explicitly to override; 0 or 1 uses the serial receive path.
# receive_workers = 2
# Outbound ESP encryption workers; L2TP_IPSEC_SEAL_WORKERS. Omit for
# clamp(GOMAXPROCS/3, 1, 4); 0 or 1 seals on the TUN reader (serial).
# Packets still leave in sequence order for every SA.
# seal_workers = 2
# Experimental IKEv1 + raw ESP and NAT-T transport. Requires CAP_NET_RAW.
enabled = true
ike_listen = ":500"
natt_listen = ":4500"
esp_listen = "0.0.0.0"
pre_shared_key = "replace-me"
server_id = "203.0.113.10"
max_sas = 1024
force_natt = true
# Receive replay window, in packets: multiples of 64 from 64 through 1024.
# Optional environment override: L2TP_IPSEC_REPLAY_WINDOW_SIZE.
replay_window_size = 1024
ike_lifetime = "8h"
esp_lifetime = "1h"
dpd_interval = "20s"
max_half_open = 128
max_sa_per_peer = 4

[limits]
sessions = 50
sessions_per_tunnel = 1
sessions_per_user = 1
# Per-source-IP token bucket for new L2TP tunnel requests. Set the rate to 0
# to disable it. Retransmissions of an existing half-open request are exempt.
new_tunnels_per_second = 5
new_tunnel_burst = 10
