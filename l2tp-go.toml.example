[server]
listen = ":1701"
hostname = "l2tp-go"
debug = false

[authentication]
method = "mschapv2"

[[authentication.users]]
username = "vpn"
password = "replace-me"

# Add more [[authentication.users]] blocks for additional accounts.

[network]
subnet = "10.0.0.0/24"
server_address = "1"
client_pool_start = "2"
client_pool_size = 50
dns = "1.1.1.1"
mtu = 1400

[tun]
enabled = true
name = "l2tp0"

[nat]
enabled = true
# Leave empty to discover the interface from the default IPv4 route.
interface = ""

[ipsec]
# Experimental IKEv1 + raw ESP and NAT-T transport. Requires CAP_NET_RAW.
enabled = true
ike_listen = ":500"
natt_listen = ":4500"
esp_listen = "0.0.0.0"
pre_shared_key = "replace-me"
server_id = "203.0.113.10"
max_sas = 1024
force_natt = true
ike_lifetime = "8h"
esp_lifetime = "1h"
dpd_interval = "20s"
max_half_open = 128
max_sa_per_peer = 4

[limits]
sessions = 50
sessions_per_tunnel = 1
sessions_per_user = 1
